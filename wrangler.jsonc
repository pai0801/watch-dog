/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "watch-dog",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-28",

	// D1 Database binding（prod = helperp@gmail.com 帳號，2026-09-05 建；舊 id 920a2626 從未存在，見 SECRETS.md）
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "watch-dog-db",
			"database_id": "2b2ec8c6-87bf-4005-98b9-56658bbda493"
		}
	],

	// Cron trigger: dead-service scan + scheduler hub, every minute.
	// 2026-10-19 從 */5 放回 */1：scheduler hub（dumb ticker）需要 1 分鐘粒度，
	// 且頻率不影響 slot 佔用——Free 5-cron 上限計的是「條數」不是「觸發頻率」
	// （getkm ef457dc42d3a 實證；2026-09-23 的「放寬 */5 讓 slot」是誤判）。
	// cleanup/usagePoll 取模錨點不受影響；偵測延遲順便縮回 1 分鐘。
	// 每分鐘 tick 的 D1 負載：讀取皆走索引小掃描＋self-pulse 寫入 ≈1.4k rows/day，
	// 無 D1 額度疑慮（本檔歷史教訓：全表掃描曾燒 ~4M rows/day）。
	"triggers": {
		"crons": ["*/1 * * * *"]
	},

	// Non-secret cross-monitor endpoint (domain C — 10-SECRETS-CONTRACT §1):
	// watch-dog POSTs a heartbeat to ops-control (independent CF account)
	// every cron tick. Token is the OPTIONAL secret OPS_CONTROL_HOST_TOKEN
	// (absent → heartbeat silently skipped; deliberately NOT in
	// secrets.required — cross-monitor must never gate the core sentinel).
	"vars": {
		"OPS_CONTROL_HEARTBEAT_URL": "https://ops-control.mbti-with-m.workers.dev"
	},

	"observability": {
		"enabled": true
	},

	// Layer 1 deploy-time secret validation (10-SECRETS-CONTRACT §5.1) — kept in
	// sync with .portability.toml [secrets].worker and src/lib/bindings.ts
	// (guards §F/§G check this). Values are NEVER written here:
	// `wrangler secret put <NAME>` (file-sourced, agents never touch plaintext).
	//
	// ⚠️ #14258 first-deploy trap: a brand-new Worker cannot have secrets set
	// before its first deploy, and secrets.required blocks that deploy. First
	// deploy flow: temporarily remove this "secrets" block → wrangler deploy →
	// wrangler secret put ADMIN_TOKEN → add the block back (10 §5.1).
	// (2026-09-05 已依此流程完成首次部署——平時這個區塊 [MUST] 保持在位。)
	"secrets": {
		"required": ["ADMIN_ACCOUNT", "ADMIN_PASSWORD", "CF_USAGE_API_TOKEN"]
	}
}
