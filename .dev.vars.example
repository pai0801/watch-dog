# Copy to .dev.vars for local development (wrangler dev / vitest).
# This file is committed as documentation — never put real values here.

# Basic-Auth pair for the /admin gate (both required, both verified).
# Password: generate one with `openssl rand -hex 24`; account is your choice.
ADMIN_ACCOUNT=change-me-local-account
ADMIN_PASSWORD=change-me-local-admin

# Static Bearer token for GET /api/cf-usage (read-only usage API).
# Generate: openssl rand -hex 32 — prod value is file-sourced via
# `wrangler secret put CF_USAGE_API_TOKEN < ~/.config/watch-dog/usage-api-token`.
CF_USAGE_API_TOKEN=change-me-local-usage-api-token

# --- Slack settings ---------------------------------------------------------
# Settings live in the D1 settings table (configured via /admin) — the single
# source of truth. The legacy SLACK_* env fallback was removed before the
# first production deploy (TODO-REVIEW #7); there are no SLACK_* env vars.
